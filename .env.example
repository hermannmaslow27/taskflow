# ==============================================================================
# TaskFlow - Variables d'Environnement
# ==============================================================================

# Base de données PostgreSQL (Neon, Supabase ou local)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/taskflow"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-a-secure-random-32-char-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Fournisseurs OAuth (Optionnels)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Automatisation Inngest (Optionnel pour exécution locale via Inngest Dev Server)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# E-mails transactionnels (Resend)
RESEND_API_KEY=""
EMAIL_FROM="notifications@taskflow.dev"
